package mycalculator1;

public class Mycalculator1 {

    public int add(int a, int b) {
        return a + b;
    }

    public int subtract(int a, int b) {
        return a - b;
    }

    public int multiply(int a, int b) {
        return a * b;
    }

    public double divide(int a, int b) {
        if (b == 0) {
            throw new IllegalArgumentException("Cannot divide by zero");
        }
        return (double) a / b;
    }
}


package mycalculator1;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class Mycalculator1Test {

    Mycalculator1 my;

    @BeforeEach
    public void setUp() {
        my = new Mycalculator1();
    }

    @AfterEach
    public void tearDown() {
        my = null;
    }

    @Test
    public void testAdd() {
        assertEquals(30, my.add(20, 10));
    }

    @Test
    public void testSubtract() {
        assertEquals(10, my.subtract(20, 10));
    }

    @Test
    public void testMultiply() {
        assertEquals(200, my.multiply(20, 10));
    }

    @Test
    public void testDivide() {
        assertEquals(2.0, my.divide(20, 10));
    }

    @Test
    public void testDivideByZero() {
        assertThrows(
            IllegalArgumentException.class,
            () -> my.divide(20, 0)
        );
    }
}
